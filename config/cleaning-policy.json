{
  "schema_version": 1,
  "id": "entice-reconciliation-v1",
  "status": "Project assumptions for reproducible reconciliation; not source certification",
  "target_year": 2023,
  "currency_unit": "M USD",
  "require_all_sectors": true,
  "parent_policy": "reviewed_or_scoped_else_declared",
  "assumptions": [
    "Unreviewed sector scopes retain their declared working parent and are reported as conditional.",
    "Selected scopes define project conventions; related activities are not automatically merged.",
    "Cached formula values are input snapshots; external Excel links are not recalculated.",
    "MSI and TVP USD labels are interpreted literally and divided by one million before allocation.",
    "LMO monetary row labels are interpreted as 2023 despite the older header.",
    "SDG monetary row units take precedence over the physical unit in its header; CEM formulas are interpreted dimensionally as MUSD.",
    "Raw trade is a prior on model deliveries; CIF/customs observations are not exact basic-price or domestic-origin observations.",
    "All coefficients and imputed targets remain estimates; baseline matrices and signed accounts are not cleaned away."
  ],
